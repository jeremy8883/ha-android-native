{
  "request": {
    "type": "frontend/get_icons",
    "category": "entity"
  },
  "result": {
    "resources": {
      "backup": {
        "event": {
          "automatic_backup_event": {
            "default": "mdi:database"
          }
        }
      },
      "sun": {
        "binary_sensor": {
          "solar_rising": {
            "default": "mdi:weather-sunny-off",
            "state": {
              "off": "mdi:weather-sunset-down",
              "on": "mdi:weather-sunset-up"
            }
          }
        },
        "sensor": {
          "next_dawn": {
            "default": "mdi:sun-clock"
          },
          "next_dusk": {
            "default": "mdi:sun-clock"
          },
          "next_midnight": {
            "default": "mdi:sun-clock"
          },
          "next_noon": {
            "default": "mdi:sun-clock"
          },
          "next_rising": {
            "default": "mdi:sun-clock"
          },
          "next_setting": {
            "default": "mdi:sun-clock"
          },
          "solar_azimuth": {
            "default": "mdi:sun-angle"
          },
          "solar_elevation": {
            "default": "mdi:theme-light-dark"
          }
        }
      },
      "demo": {
        "climate": {
          "ubercool": {
            "state_attributes": {
              "fan_mode": {
                "state": {
                  "auto_high": "mdi:fan-auto",
                  "auto_low": "mdi:fan-auto",
                  "on_high": "mdi:fan-chevron-up",
                  "on_low": "mdi:fan-chevron-down"
                }
              },
              "swing_horizontal_mode": {
                "state": {
                  "auto": "mdi:compare-horizontal",
                  "off": "mdi:arrow-oscillating-off",
                  "rangefull": "mdi:pan-horizontal"
                }
              },
              "swing_mode": {
                "state": {
                  "1": "mdi:numeric-1",
                  "2": "mdi:numeric-2",
                  "3": "mdi:numeric-3",
                  "auto": "mdi:arrow-oscillating",
                  "off": "mdi:arrow-oscillating-off"
                }
              }
            }
          }
        },
        "fan": {
          "demo": {
            "state_attributes": {
              "preset_mode": {
                "default": "mdi:circle-medium",
                "state": {
                  "auto": "mdi:fan-auto",
                  "on": "mdi:power",
                  "sleep": "mdi:bed",
                  "smart": "mdi:brain"
                }
              }
            }
          }
        },
        "light": {
          "bed_light": {
            "state_attributes": {
              "effect": {
                "state": {
                  "rainbow": "mdi:looks"
                }
              }
            }
          }
        },
        "number": {
          "pwm": {
            "default": "mdi:square-wave"
          },
          "range": {
            "default": "mdi:square-wave"
          },
          "volume": {
            "default": "mdi:volume-high"
          }
        },
        "select": {
          "speed": {
            "state": {
              "light_speed": "mdi:speedometer-slow",
              "ludicrous_speed": "mdi:speedometer-medium",
              "ridiculous_speed": "mdi:speedometer"
            }
          }
        },
        "sensor": {
          "thermostat_mode": {
            "state": {
              "away": "mdi:home-export-outline",
              "comfort": "mdi:home-account",
              "eco": "mdi:leaf",
              "sleep": "mdi:weather-night"
            }
          }
        },
        "switch": {
          "air_conditioner": {
            "default": "mdi:air-conditioner"
          }
        }
      },
      "shopping_list": {
        "todo": {
          "shopping_list": {
            "default": "mdi:cart"
          }
        }
      },
      "mobile_app": {
        "notify": {
          "notify": {
            "default": "mdi:cellphone-message"
          }
        }
      },
      "group": {
        "light": {
          "light": {
            "default": "mdi:lightbulb-group",
            "state": {
              "off": "mdi:lightbulb-group-off"
            }
          }
        }
      }
    }
  }
}
