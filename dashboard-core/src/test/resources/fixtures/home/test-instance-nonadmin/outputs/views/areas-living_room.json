              "text": "Off",
              "tap_action": {
                "action": "perform-action",
                "perform_action": "light.turn_on",
                "target": {
                  "area_id": "living_room"
                }
              },
              "visibility": [
                {
                  "condition": "not",
                  "conditions": [
                    {
                      "condition": "or",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "light.ceiling_lights",
                          "state": "on"
                        },
                        {
                          "condition": "state",
                          "entity": "light.living_room_rgbww_lights",
                          "state": "on"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "button",
              "icon": "mdi:power",
              "color": "orange",
              "text": "On",
              "tap_action": {
                "action": "perform-action",
                "perform_action": "light.turn_off",
                "target": {
                  "area_id": "living_room"
                }
              },
              "visibility": [
                {
                  "condition": "or",
                  "conditions": [
                    {
                      "condition": "state",
                      "entity": "light.ceiling_lights",
                      "state": "on"
                    },
                    {
                      "condition": "state",
                      "entity": "light.living_room_rgbww_lights",
                      "state": "on"
                    }
